# tooling / test caches (not part of the repo)
node_modules/
.npm-cache/
.playwright-browsers/
.test-artifacts/
__pycache__/
*.py[cod]

# OS noise
.DS_Store
Thumbs.db

# The AqKanji2Koe dictionaries are licensed SDK data and stay out of git.
# Put aqdic.bin + lookup.bin in engines/aqk2k/aqk2k_lnx/aq_dic/ to enable
# the AqKanji2Koe tab (aq_user.dic and CREDITS are committed).
/engines/aqk2k/aqk2k_lnx/aq_dic/aqdic.bin
/engines/aqk2k/aqk2k_lnx/aq_dic/lookup.bin

# local aqk2k debugging artifacts
/engines/aqk2k/.tmp/
/engines/aqk2k/port/build-native-dbg/

# relocatable single-memory build
/dist/
**/.reloc-tmp/
/link/host/target/

# default outputs of the per-engine build-reloc scripts
/engines/aquestalk1/dist/reloc/
/engines/aquestalk2/dist/reloc/
/engines/aquestalk10/port/web/reloc/
/engines/aqk2k/port/build-wasm32/reloc/
/engines/aqk2k/port_usr/build-wasm32/reloc/
