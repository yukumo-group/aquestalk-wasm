#ifndef AQ_CXX_UTILITY
#define AQ_CXX_UTILITY
#include <stddef.h>
namespace std {
#ifndef AQ_CXX_SWAP_DEFINED
#define AQ_CXX_SWAP_DEFINED
template <typename T> void swap(T &a, T &b) { T t(a); a = b; b = t; }
#endif
template <typename T> T &&move(T &x) { return static_cast<T &&>(x); }
template <typename A, typename B> struct pair {
  A first; B second;
  pair() : first(), second() {}
  pair(const A &a, const B &b) : first(a), second(b) {}
  bool operator<(const pair &o) const { return first < o.first || (first == o.first && second < o.second); }
};
template <typename A, typename B> pair<A, B> make_pair(const A &a, const B &b) { return pair<A, B>(a, b); }
}
#endif
